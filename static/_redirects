# Cloudflare Pages redirect rules for wildcard routing mode
# Documentation: https://developers.cloudflare.com/pages/platform/redirects

# IMPORTANT: Specific paths MUST come before generic /:projectId pattern
# to prevent incorrect matches (e.g., /credits being matched as project ID)

# Addon settings page
/addons  /addons.html  200
/addons/  /addons.html  200

# Credits page
/credits  /credits.html  200
/credits/  /credits.html  200

# Privacy policy page
/privacy  /privacy.html  200
/privacy/  /privacy.html  200

# Editor without project ID
/editor  /editor.html  200
/editor/  /editor.html  200

# Fullscreen without project ID
/fullscreen  /fullscreen.html  200
/fullscreen/  /fullscreen.html  200

# Embed without project ID
/embed  /embed.html  200
/embed/  /embed.html  200

# Project ID + editor
/:projectId/editor  /editor.html  200
/:projectId/editor/  /editor.html  200

# Project ID + fullscreen
/:projectId/fullscreen  /fullscreen.html  200
/:projectId/fullscreen/  /fullscreen.html  200

# Project ID + embed
/:projectId/embed  /embed.html  200
/:projectId/embed/  /embed.html  200

# Project ID only (player)
# Must be LAST to avoid matching /credits, /privacy, etc.
/:projectId  /index.html  200
/:projectId/  /index.html  200

# Default homepage is index.html, no configuration needed
